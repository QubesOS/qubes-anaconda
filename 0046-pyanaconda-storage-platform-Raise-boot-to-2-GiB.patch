From 73238e5fcb6fd57303ee980889ce9db3b90a125f Mon Sep 17 00:00:00 2001
From: Neal Gompa <neal@gompa.dev>
Date: Wed, 8 Oct 2025 09:35:59 -0400
Subject: [PATCH] pyanaconda: storage: platform: Raise /boot to 2 GiB

With the increase in content in initramfs, a long-overdue raise
of the default size for /boot is warranted.

Reference: https://fedoraproject.org/wiki/Changes/2GbootPartition

(cherry picked from commit 9ce73783d03db93833b92789075af1c6d3527ab0)

# Conflicts:
#	tests/unit_tests/pyanaconda_tests/modules/storage/test_platform.py
---
 pyanaconda/modules/storage/platform.py        |  4 +--
 .../modules/storage/test_platform.py          | 26 +++++++++----------
 2 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/pyanaconda/modules/storage/platform.py b/pyanaconda/modules/storage/platform.py
index 5397f2c992..7bdde0b8a5 100644
--- a/pyanaconda/modules/storage/platform.py
+++ b/pyanaconda/modules/storage/platform.py
@@ -134,7 +134,7 @@ class Platform(object):
         """
         return PartSpec(
             mountpoint="/boot",
-            size=Size("1GiB")
+            size=Size("2GiB")
         )
 
 
@@ -378,7 +378,7 @@ class S390(Platform):
         """The default /boot partition for this platform."""
         return PartSpec(
             mountpoint="/boot",
-            size=Size("1GiB"),
+            size=Size("2GiB"),
             lv=False
         )
 
